---
import Layout from '../../layouts/Layout.astro';import BookCard from '../../components/BookCard.astro';import Newsletter from '../../components/Newsletter.astro';import {books,seriesFor,seriesBooks,statusLabel,site} from '../../data/catalog';
export function getStaticPaths(){return books.map(book=>({params:{slug:book.slug},props:{book}}));}
const {book}=Astro.props;const series=seriesFor(book.seriesId);const related=seriesBooks(series.id).filter(b=>b.slug!==book.slug);
const schema={'@context':'https://schema.org','@type':'Book','@id':new URL(`/books/${book.slug}/`,site.url).href,name:book.title,author:book.contributors.filter((c:any)=>c.role==='author').map((c:any)=>({'@type':'Person',name:c.creditedAs})),inLanguage:'en',description:book.hook,image:new URL(book.cover!,site.url).href,url:new URL(`/books/${book.slug}/`,site.url).href,isPartOf:{'@type':'BookSeries',name:series.name},publisher:{'@type':'Organization',name:site.name},workExample:book.editions.map((e:any)=>({'@type':'Book',bookFormat:e.format==='kindle'?'https://schema.org/EBook':'https://schema.org/Paperback',...(e.isbn13?{isbn:e.isbn13}:{}),...(e.publicationDate?{datePublished:e.publicationDate}:{}),...(e.pageCount&&e.format!=='kindle'?{numberOfPages:e.pageCount}:{}),inLanguage:e.language,url:e.links[0]?.url}))};
const date=(value:string)=>new Date(value+'T12:00:00Z').toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'});
---
<Layout title={`${book.title} by ${book.author}`} description={book.seo.description} image={`/social/${book.slug}.jpg`} schema={schema} type="book"><div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/books/">Books</a><span aria-hidden="true">/</span><a href={`/series/${series.slug}/`}>{series.name}</a></nav><section class="book-detail"><div class:list={['book-detail-art',series.color]}><img src={book.cover!} alt={`${book.title} cover, ${book.author}`} width={book.coverWidth} height={book.coverHeight} fetchpriority="high"/></div><div class="book-detail-copy"><div class="book-heading"><p class="eyebrow">{series.name} <span aria-hidden="true">/</span> Book {book.order}</p><h1>{book.title}</h1><p class="detail-author">By {book.contributors.filter((c:any)=>c.role==='author').map((c:any)=><a href={`/authors/${c.authorId}/`}>{c.creditedAs}</a>)}</p>{book.literaryIdentification&&<p class="literary-identification">{book.literaryIdentification}</p>}<div class="detail-tags"><span class:list={['status',book.status]}>{statusLabel(book.status)}</span><span>{book.genre}</span></div></div><div class="book-story"><h2 class="book-hook" id="story">{book.hook}</h2><div class="prose">{book.paragraphs.map((p:string)=><p>{p}</p>)}</div><div class="retailer-actions">{book.links.map((l:any,i:number)=><a class:list={['button',i>0&&'outline']} href={l.url}>{l.label} <span aria-hidden="true">↗</span></a>)}</div><p class="fine">Opens Amazon.com. Availability and formats may vary by country.</p>{book.excerpt&&<a class="sample-link" href={book.excerpt.url}>{book.excerpt.label} ↗</a>}</div></div></section></div>
{book.playlist&&<section class="music-section" id="music"><div class="wrap music-inner"><div><p class="eyebrow">Listen while you read</p><h2>Music is part<br/>of the story.</h2><p>The songs carry memory, desire, comedy, and things the characters cannot quite say. Listen along with the companion playlist—or let the novel supply the music.</p></div><div class="playlist-access"><a href={book.playlist.url}>Listen on Spotify ↗</a>{book.qr&&<figure class="playlist-qr"><a href={book.playlist.url} aria-label="Open the My Blue Heaven companion playlist on Spotify"><img src={book.qr} width="900" height="900" alt="QR code for the My Blue Heaven Spotify playlist." loading="lazy"/></a><figcaption>Scan to listen on another device.</figcaption></figure>}</div></div></section>}
<div class="wrap"><section class="section"><div class="section-heading"><div><p class="eyebrow">Choose your edition</p><h2>Find your copy.</h2></div></div><div class="edition-grid">{book.editions.map((e:any)=><article class="edition"><h3>{e.format==='kindle'?'Kindle':e.format==='paperback'?'Paperback':e.format}</h3><p>English{e.pageCount&&e.format!=='kindle'?` · ${e.pageCount} pages`:''}{e.publicationDate?` · Published ${date(e.publicationDate)}`:''}</p>{e.isbn13&&<p>ISBN: {e.isbn13}</p>}{e.links.filter((l:any)=>l.verification==='destination-verified').map((l:any)=><a class="text-link" href={l.url}>{l.label} ↗</a>)}</article>)}</div></section><section class="series-context top-border"><p class="eyebrow">{series.name}</p><h2>{book.prequelToBookId?'Book Two. A beginning.':'More lives. More trouble.'}</h2>{book.chronologyNote&&<p>{book.chronologyNote}</p>}<p>{series.description}</p><a class="text-link" href={`/series/${series.slug}/`}>Explore the series and book order →</a></section><section class="section"><div class="section-heading"><h2>More in the series.</h2></div><div class="book-grid related">{related.map(b=><BookCard book={b}/>)}</div></section></div><Newsletter embedded/>
</Layout>
