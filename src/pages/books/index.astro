---
import Layout from '../../layouts/Layout.astro';import BookCard from '../../components/BookCard.astro';import Newsletter from '../../components/Newsletter.astro';import {books} from '../../data/catalog';
---
<Layout title="Books" description="Explore the Public Domain Pulp catalog: romantic adventures, time-travel romance, and noir crime fiction."><header class="page-intro wrap"><p class="eyebrow">The catalog</p><h1>Good company.<br/><em>Bad decisions.</em></h1><p>Showgirls, sailors, time travellers, and detectives. Find a story to get lost in.</p><nav class="section-jumps" aria-label="Catalog sections"><a href="#available">Available now ↓</a><a href="#forthcoming">On the horizon ↓</a></nav></header><section class="section wrap" id="available"><div class="section-heading"><h2>Available now.</h2></div><div class="book-grid">{books.filter(b=>b.status==='available').map(b=><BookCard book={b}/>)}</div></section><section class="section wrap top-border" id="forthcoming"><div class="section-heading"><div><p class="eyebrow">Your next chapter</p><h2>On the horizon.</h2></div></div><div class="book-grid">{books.filter(b=>b.status!=='available').map(b=><BookCard book={b}/>)}</div></section><Newsletter/></Layout>
