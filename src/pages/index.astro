---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import Newsletter from '../components/Newsletter.astro';
import JournalList from '../components/JournalList.astro';
import SeriesPanel from '../components/SeriesPanel.astro';
import {books,series,site,seriesFor} from '../data/catalog';
const featured=books.find(b=>b.slug===site.featured)!;
---
<Layout title="Original stories. Familiar characters.">
 <section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="tiny-rule"></span> Independent fiction. New possibilities.</p><h1>The public domain<br/><em>is not a museum.</em></h1><p class="hero-intro">New romance, noir, and adventure fiction. Familiar characters with lives, ambitions, and trouble their original stories never imagined.</p><div class="hero-actions"><a class="button" href="/books/">Explore the books <span aria-hidden="true">→</span></a><a class="text-link" href={`/books/${featured.slug}/`}>Explore {featured.title}</a></div><div class="hero-credit"><span class="eyebrow">Featured book</span><span><a href={`/books/${featured.slug}/`}>{featured.title}</a> <span aria-hidden="true">/</span> {featured.author}</span></div><div class="hero-signup" id="subscribe"><p class="eyebrow">New books. Straight to your inbox.</p><iframe class="signup-embed" src={site.newsletterEmbed} title="Subscribe to Public Domain Pulp on Substack" width="480" height="340" loading="eager"></iframe><a class="signup-fallback" href={site.newsletter}>Subscribe directly on Substack ↗</a></div></div><div class="hero-art"><span class="hero-vertical" aria-hidden="true">{seriesFor(featured.seriesId).name} / Book {featured.order}</span><a href={`/books/${featured.slug}/`} aria-label={`Explore ${featured.title}`}><img src={featured.cover!} alt="" width="500" height="750" fetchpriority="high"/></a></div></section>
 <div class="brand-rule"><div class="wrap"><span>Respect the source.</span><span>Respect the genre.</span><span>Make something new.</span><span class="rule-star" aria-hidden="true">✦</span></div></div>
 <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Find your next story</p><h2>On the bookshelf.</h2></div><a class="text-link" href="/books/">All books <span aria-hidden="true">→</span></a></div><div class="book-grid">{books.filter(b=>b.status==='available').map(b=><BookCard book={b}/>)}</div></section>
 <section class="series-section section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Find your kind of trouble</p><h2>A world for every appetite.</h2></div><a class="text-link" href="/series/">Our series <span aria-hidden="true">→</span></a></div><div class="series-stack">{series.map(s=><SeriesPanel series={s}/>)}</div></div></section>
 <section class="manifesto-block wrap section"><div><p class="eyebrow">Our point of view</p><h2>The public domain<br/>is not a museum<span>.</span></h2></div><div><p class="large-copy">The characters should still feel like themselves. The story should be one you’ve never read.</p><p>We go back to the source, then make something new: stories with laughter, danger, desire, and lives of their own.</p><a class="text-link" href="/about/">Meet Public Domain Pulp <span aria-hidden="true">→</span></a></div></section>
 <section class="section journal-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">From the journal</p><h2>Between the books.</h2></div><a class="text-link" href="/journal/">Visit the journal <span aria-hidden="true">→</span></a></div><JournalList/></div></section><Newsletter/>
</Layout>
