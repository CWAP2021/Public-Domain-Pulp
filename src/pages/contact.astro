---
import Layout from '../layouts/Layout.astro';import Newsletter from '../components/Newsletter.astro';import {site,feedbackMode} from '../data/catalog';
const delivered=feedbackMode==='netlify';
---
<Layout title="Contact" description="Questions, comments, or feedback for Public Domain Pulp? Write to info@publicdomainpulp.net."><header class="page-intro wrap"><p class="eyebrow">Get in touch</p><h1>We’re listening.</h1><p>Questions about the books, reader feedback, or something you’d like to know. There’s room for all of it.</p></header><section class="section wrap two-column"><div><h2>Write to the publisher.</h2><p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p><p>Tell us which book you’re reading, what caught your attention, or what information you would like back.</p><p class="fine">Sending feedback does not add you to a mailing list. Newsletter subscriptions are separate.</p></div><form class="contact-form" name="reader-feedback" method={delivered?'POST':'GET'} action={delivered?'/contact/thanks/':`mailto:${site.contactEmail}`} data-netlify={delivered?'true':undefined} netlify-honeypot={delivered?'company':undefined} data-delivery={feedbackMode} data-recipient={site.contactEmail}><input type="hidden" name="form-name" value="reader-feedback"/>{delivered&&<p class="visually-hidden"><label>Leave this field empty<input name="company" tabindex="-1" autocomplete="off"/></label></p>}<div><label for="reader-name">Name <span class="fine">(optional)</span></label><input id="reader-name" name="name" autocomplete="name" maxlength="160"/></div><div><label for="reader-email">Email address <span class="fine">(required)</span></label><input id="reader-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-help"/><p id="email-help" class="form-note">Where we can reply to your message.</p></div><div><label for="reader-message">Your message <span class="fine">(required)</span></label><textarea id="reader-message" name="message" rows="9" required maxlength="12000" aria-describedby="message-help"></textarea><p id="message-help" class="form-note">Feedback, questions, or information you’d like from us.</p></div><p class="form-note" id="delivery-note">{delivered?'Your message will be submitted to Public Domain Pulp.':"This prepares a message in your email app. Nothing is sent until you send the email there."}</p><button class="button" type="submit">{delivered?'Send message':'Prepare email'} <span aria-hidden="true">→</span></button><p class="form-result" id="contact-result" role="status" hidden></p></form></section><Newsletter/>
<script>
 const form=document.querySelector<HTMLFormElement>('.contact-form');
 if(form?.dataset.delivery==='email')form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const body=`Name: ${data.get('name')||'Not provided'}\nReply email: ${data.get('email')}\n\n${data.get('message')}`;const link=`mailto:${form.dataset.recipient}?subject=${encodeURIComponent('Reader message — Public Domain Pulp')}&body=${encodeURIComponent(body)}`;window.location.href=link;const result=document.querySelector<HTMLElement>('#contact-result');if(result){result.hidden=false;result.textContent='Your email app should open with a draft. Please review and send it there. If it does not open, email info@publicdomainpulp.net directly.';}});
</script></Layout>
