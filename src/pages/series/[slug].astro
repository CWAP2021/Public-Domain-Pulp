---
import Layout from '../../layouts/Layout.astro';import BookCard from '../../components/BookCard.astro';import Newsletter from '../../components/Newsletter.astro';import {series,seriesBooks,books} from '../../data/catalog';
export function getStaticPaths(){return series.map(series=>({params:{slug:series.slug},props:{series}}));}
const {series:s}=Astro.props;const titles=seriesBooks(s.id);
---
<Layout title={s.name} description={s.description}><header class:list={['series-intro',s.color]}><div class="wrap"><p class="eyebrow">{s.genre} <span aria-hidden="true">/</span> {s.author}</p><h1>{s.name}</h1><p>{s.description}</p><a class="button light" href={`/books/${titles[0].slug}/`}>Explore Book One <span aria-hidden="true">→</span></a></div></header><section class="section wrap"><div class="section-heading"><div><p class="eyebrow">The bookshelf</p><h2>Books in series order.</h2></div></div>{s.storyChronology?.length>0&&<div class="order-note"><p>Publication order: {s.publicationOrder.map((id:string)=>books.find(b=>b.id===id)?.title).join(' → ')}.</p><p>Story chronology: {s.storyChronology.map((id:string)=>books.find(b=>b.id===id)?.title).join(' → ')}.</p>{titles.filter(b=>b.prequelToBookId).map(b=><p>{b.title} is the prequel to {books.find(x=>x.id===b.prequelToBookId)?.title}.</p>)}</div>}<div class="book-grid series-books">{titles.map(b=><BookCard book={b}/>)}</div></section><Newsletter/></Layout>
